.runtime/
__pycache__/
worlds/.*.wbproj

# Explicitly retain the configuration and the two reviewed validation runs.
!config.json
!results/
results/*
!results/baseline/
!results/repeat/
!results/baseline/**
!results/repeat/**

# Final research protocols and audited evidence; private/development runs stay ignored.
!research/*.json
!results/research-core/
!results/research-core/**
!results/research-training/
!results/research-training/**
!results/research-evaluation/
!results/research-evaluation/**
!results/physical-validated/
!results/physical-validated/**
!results/physical-tracking-final/
!results/physical-tracking-final/**
!results/physical-transfer-final/
!results/physical-transfer-final/**
!results/actuator-parity/
!results/actuator-parity/**
**/__pycache__/

# Revision 2 preserves the previous campaign and records its own split.
!research/revision2/*.json
!results/revision2-development/
!results/revision2-development/**
!results/revision2-test/
!results/revision2-test/**
**/__pycache__/

# Frozen-gate native transfer evidence (prior campaigns remain immutable).
!research/revision2/native/*.json
!results/revision2-native-smoke/
!results/revision2-native-smoke/**
!results/revision2-native-test/
!results/revision2-native-test/**
**/__pycache__/

# Range-matched residual training is separate from all prior evidence.
!research/revision3/*.json
!results/revision3-training-smoke/
!results/revision3-training-smoke/**
!results/revision3-training/
!results/revision3-training/**
!results/revision3-test/
!results/revision3-test/**
!results/revision3-native-smoke/
!results/revision3-native-smoke/**
**/__pycache__/

!results/revision3-pilots/
!results/revision3-pilots/**
**/__pycache__/

!results/revision3-extended/
!results/revision3-extended/**
**/__pycache__/

!results/revision3-600k/
!results/revision3-600k/**
**/__pycache__/

!research/revision4/*.json
!results/revision4-smoke/
!results/revision4-smoke/**
!results/revision4-pilots/
!results/revision4-pilots/**
**/__pycache__/
!research/revision5/*.json
!results/controller-remediation/
!results/controller-remediation/**
